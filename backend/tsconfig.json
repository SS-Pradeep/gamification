{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ESNext"],
    "outDir": "build",
    "rootDir": "src",
    "sourceMap": true,
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": false,
    "incremental": true,
    "paths": {
      "#root/*": ["./*"],
      "#shared/*": ["./shared/*"],
      "#auth/*": ["./modules/auth/*"],
      "#courses/*": ["./modules/courses/*"],
      "#users/*": ["./modules/users/*"],
      "#quizzes/*": ["./modules/quizzes/*"],
      "#settings/*": ["./modules/settings/*"],
      "#gamification/*": ["./modules/gamification/*"]
    },
    "types": ["node", "express"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "exclude": [
    "build",
    "**/*.test.ts",
    "dist",
    "**/*.spec.ts",
    "**/*.d.ts",
    "vite.config.ts"
  ]
}
